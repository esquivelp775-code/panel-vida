# Copia a backend/.env y ajusta. NUNCA subas .env al repositorio.
PANEL_ENV=development
PANEL_DATABASE_URL=postgresql+psycopg://panel:CAMBIA_ESTO@localhost:5432/panel_vida
# Genera con: python -c "import secrets; print(secrets.token_urlsafe(48))"
PANEL_SECRET_KEY=CAMBIA_ESTO_POR_UN_SECRETO_LARGO_Y_ALEATORIO
PANEL_TOKEN_TTL_MINUTES=720
# Orígenes del frontend separados por coma (sin '*')
PANEL_CORS_ORIGINS=http://localhost:3000
# Zona horaria del usuario: define qué día es "hoy". Vacío = la del sistema.
PANEL_TIMEZONE=America/Mexico_City
